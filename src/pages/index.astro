---
import Page from "@layouts/Page.astro";
import { data, latestVersion, sortItems, supportsLatestVersion, type Item, type Server } from "../data";
import { getServerStatus, initializePinger } from "../ping";

await initializePinger();

const resolveVersion = (item: Item | Server): string | undefined =>
    "ip" in item ? getServerStatus(item.ip)?.version ?? item.version : item.version;

const hasServers = (items: (Item | Server)[]): boolean => items.some((item) => "ip" in item);

const serverSection = (() => {
    const category = data.find((category) => hasServers(category.items));
    if (!category) return undefined;

    const servers = sortItems(category.items, resolveVersion)
        .filter((item): item is Server => "ip" in item)
        .map((server) => ({
            server,
            status: getServerStatus(server.ip),
            version: resolveVersion(server),
            supported: supportsLatestVersion(resolveVersion(server))
        }));

    return { title: category.title, servers };
})();

const otherSections = data
    .filter((category) => !hasServers(category.items))
    .map((category) => ({
        title: category.title,
        items: category.items.filter((item): item is Item => !("ip" in item))
    }));
---
<Page title="Awesome Minestom">
    <Fragment slot="meta">
        <meta name="theme-color" content="#FF6C32" />
        <meta name="description" content="A collection of awesome Minestom resources." />
        <meta property="og:title" content="minestom.rocks" />
        <meta property="og:description" content="A collection of awesome Minestom resources." />
    </Fragment>

    <div id="header">
        <label>
            <input type="checkbox" id="filter-latest" />
            Show {latestVersion} projects only
        </label>
    </div>

    {serverSection && (
        <section>
            <h2>{serverSection.title}</h2>
            <div id="server-grid">
                {serverSection.servers.map(({ server, status, version, supported }) => (
                    <div class="server-card" data-supports-latest={supported}>
                        <div class="server-card-header">
                            {status?.icon ? (
                                <img class="server-icon" src={status.icon} alt="" />
                            ) : (
                                <div class="server-icon server-icon-placeholder"></div>
                            )}
                            <h3>{server.name}</h3>
                            {status && (status.online ? (
                                status.players && <span class="players">{status.players.online}/{status.players.max}</span>
                            ) : (
                                <span class="players offline">offline</span>
                            ))}
                        </div>

                        <p class="server-description">{server.description}</p>

                        <div class="server-card-footer">
                            {version ? (
                                <span class="server-version">({version})</span>
                            ) : (
                                <span></span>
                            )}
                            <div class="server-buttons">
                                <button class="server-button copy-ip" data-ip={server.ip}>Copy IP</button>
                                {server.website && (
                                    <a class="server-button" href={server.website} target="_blank" rel="noopener noreferrer">Website</a>
                                )}
                                {server.github && (
                                    <a class="server-button" href={server.github} target="_blank" rel="noopener noreferrer">GitHub</a>
                                )}
                                {server.discord && (
                                    <a class="server-button" href={`https://discord.com/invite/${server.discord}`} target="_blank" rel="noopener noreferrer">Discord</a>
                                )}
                            </div>
                        </div>
                    </div>
                ))}
            </div>
        </section>
    )}

    {otherSections.map((category) => (
        <section>
            <h2>{category.title}</h2>
            <ul>
                {category.items.map((item) => (
                    <li data-supports-latest={supportsLatestVersion(item.version)}>
                        {item.link ? (
                            <a href={item.link} target="_blank" rel="noopener noreferrer">{item.name}</a>
                        ) : (
                            <span>{item.name}</span>
                        )}
                        {" "}- {item.description} {item.version ? <span style="color: var(--muted)">({item.version})</span> : <Fragment />}
                    </li>
                ))}
            </ul>
        </section>
    ))}

    <p id="footer">
        Star the project on <a href="https://github.com/mudkipdev/minestom.rocks">GitHub</a>.
        Also try our <a href="/install">build script generator!</a>
    </p>
</Page>

<style>
    #header {
        margin-bottom: 16px;
    }

    #footer, #footer a {
        margin-top: 16px;
        margin-bottom: 32px;
        color: var(--muted);
    }

    #server-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
        gap: 16px;
        margin: 16px 0;
    }

    @media (max-width: 700px) {
        #server-grid {
            grid-template-columns: 1fr;
        }
    }

    .server-card {
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding: 16px;
        border: 1px solid rgba(128, 128, 128, 0.3);
        border-radius: 12px;
        background: rgba(128, 128, 128, 0.05);
    }

    .server-card-header {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .server-card-header h3 {
        margin: 0;
        font-size: 1.1em;
        overflow-wrap: anywhere;
    }

    .server-icon {
        width: 48px;
        height: 48px;
        border-radius: 6px;
        object-fit: contain;
        image-rendering: pixelated;
        flex-shrink: 0;
    }

    .server-icon-placeholder {
        background: rgba(128, 128, 128, 0.2);
    }

    .players {
        margin-left: auto;
        padding: 2px 10px;
        border-radius: 999px;
        background: rgba(63, 185, 80, 0.15);
        color: #2da44e;
        font-size: 0.75em;
        white-space: nowrap;
    }

    .players.offline {
        background: rgba(128, 128, 128, 0.12);
        color: var(--muted);
    }

    @media (prefers-color-scheme: dark) {
        .players {
            background: rgba(63, 185, 80, 0.18);
            color: #3fb950;
        }
    }

    .server-description {
        flex-grow: 1;
        color: var(--foreground);
        opacity: 0.85;
        line-height: 1.4;
    }

    .server-card-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
    }

    .server-version {
        color: var(--muted);
        white-space: nowrap;
    }

    .server-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        justify-content: flex-end;
    }

    .server-button {
        padding: 4px 12px;
        border: 1px solid rgba(128, 128, 128, 0.4);
        border-radius: 6px;
        background: none;
        color: var(--foreground);
        font-size: 14px;
        text-decoration: none;
        cursor: pointer;
        transition: border-color 0.15s, color 0.15s;
    }

    .server-button:hover {
        border-color: var(--link);
        color: var(--link);
    }

    .server-button.copy-ip.copied {
        border-color: #2da44e;
        color: #2da44e;
    }

    @media (prefers-color-scheme: dark) {
        .server-button.copy-ip.copied {
            border-color: #3fb950;
            color: #3fb950;
        }
    }
</style>

<script>
    const checkbox = document.querySelector("#filter-latest") as HTMLInputElement;
    const sections = document.querySelectorAll("section");

    checkbox.addEventListener("change", () => {
        sections.forEach(section => {
            const entries = section.querySelectorAll("[data-supports-latest]");
            let visibleCount = 0;

            entries.forEach(entry => {
                const supported = entry.getAttribute("data-supports-latest") === "true";
                (entry as HTMLElement).style.display = (!checkbox.checked || supported) ? "" : "none";
                if (!checkbox.checked || supported) visibleCount++;
            });

            section.style.display = visibleCount > 0 ? "" : "none";
        });
    });
</script>

<script>
    document.querySelectorAll<HTMLButtonElement>(".copy-ip").forEach(button => {
        button.addEventListener("click", () => {
            const ip = button.dataset.ip;
            if (!ip) return;

            navigator.clipboard.writeText(ip).then(() => {
                button.classList.add("copied");
                button.textContent = "Copied!";
                setTimeout(() => {
                    button.classList.remove("copied");
                    button.textContent = "Copy IP";
                }, 1000);
            });
        });
    });
</script>

<script>
    function replaceTextInNode(node: Node) {
        if (node.nodeType === Node.TEXT_NODE && node.textContent != null) {
            node.textContent = node.textContent
                .replace("Minestom", "Minestorm")
                .replace("minestom", "minestorm");
        } else if (node.nodeType === Node.ELEMENT_NODE) {
            node.childNodes.forEach(replaceTextInNode);
        }
    }

    const today = new Date();
    const isAprilFools = today.getMonth() === 3 && today.getDate() === 1;

    if (Math.random() < 0.01 || isAprilFools) {
        document.title = document.title.replace("Minestom", "Minestorm");
        document.querySelectorAll("li, .server-card").forEach(node => {
            if (node instanceof Element) replaceTextInNode(node);
        });
    }
</script>
